<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- 1. Noi dung chinh cua Activity (boc trong FrameLayout de ho tro lop overlay khoa sinh trac hoc) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/black">

            <!-- Container cho cac Fragment: Home, Files, History, Settings -->
            <FrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Thanh Bottom Navigation bo tron phia tren -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_bottom_nav_rounded"
                app:menu="@menu/bottom_nav_menu" />

        </LinearLayout>

    </FrameLayout>

    <!-- 2. Navigation Drawer tuy chinh theo mau -->
    <include
        layout="@layout/layout_nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>