<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">


    <!-- ── TAB: Original / Extracted / AI ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <!-- Tab Original -->
        <TextView
            android:id="@+id/tabOriginal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Ảnh gốc"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <!-- Tab Extracted (active mặc định) -->
        <TextView
            android:id="@+id/tabExtracted"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Văn bản"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/background"
            android:background="@color/primary"
            android:clickable="true"
            android:focusable="true" />

        <!-- Tab Trợ lý AI (mới) -->
        <TextView
            android:id="@+id/tabAi"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Trợ lý AI"
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── BADGE: DOCUMENT EXTRACTED ── -->
    <TextView
        android:id="@+id/txtStatusBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ĐÃ TRÍCH XUẤT"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/status_badge_green"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/surface" />

    <!-- ── NỘI DUNG CHÍNH (cuộn được) ── -->
    <ScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card nội dung text trích xuất -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExtractedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Header card: Tiêu đề + Nút Chỉnh sửa văn bản trực tiếp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Văn bản trích xuất"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />

                        <!-- Nút Chỉnh sửa trực tiếp trên Card văn bản -->
                        <LinearLayout
                            android:id="@+id/btnQuickEditCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/primary"
                                android:layout_marginEnd="5dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Chỉnh sửa"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/txtExtractedContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:text="(Chưa có nội dung)"
                        android:textIsSelectable="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Ảnh gốc (hiện khi tab Original) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOriginalImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgOriginal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter" />

                    <!-- Thanh chuyen trang neu tai lieu co nhieu trang -->
                    <LinearLayout
                        android:id="@+id/layoutDieuHuongTrang"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#F8FAFC"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrangTruoc"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Trang trước"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtChiSoTrang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:text="Trang 1 / 1"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTrangSau"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Trang sau"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- layoutAiSection đã được chuyển ra ngoài ScrollView thành layoutAiTab -->

        </LinearLayout>

    </ScrollView>

    <!-- ── TAB TRỢ LÝ AI — full height, không nằm trong ScrollView ── -->
    <LinearLayout
        android:id="@+id/layoutAiTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone">

        <!-- Header nhỏ phía trên: tiêu đề phụ + nút xóa chat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hội thoại với Gemini"
                android:textSize="12sp"
                android:textColor="@color/text_hint" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearQa"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa chat"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- Loading inline khi AI đang xử lý -->
        <LinearLayout
            android:id="@+id/layoutAiLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/surface"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:id="@+id/txtAiLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini đang xử lý..."
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- ListView chat chiếm toàn bộ chiều cao còn lại -->
        <ListView
            android:id="@+id/lvQaHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Placeholder khi chưa có hội thoại -->
        <LinearLayout
            android:id="@+id/layoutQaPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtQaPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Hỏi Gemini về nội dung tài liệu\nhoặc chọn gợi ý nhanh ở bên dưới"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Hàng chip gợi ý nhanh (nằm ngay phía trên thanh nhập) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/surface"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTomTat"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tóm tắt"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDichTV"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dịch TV"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTrichXuat"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trích xuất"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNoiDungChinh"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nội dung chính?"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSoLieu"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số liệu"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Input bar cố định đáy -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@color/surface">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundColor="@color/surface"
                app:boxStrokeColor="@color/divider"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCauHoi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Hỏi về tài liệu này..."
                    android:textSize="13sp"
                    android:inputType="text"
                    android:imeOptions="actionSend"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:maxLines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuiCauHoi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gửi"
                android:textSize="13sp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/background"
                app:cornerRadius="20dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── TOOLBAR HÀNH ĐỘNG: Edit / New / Share / Export ── -->
    <View
        android:id="@+id/viewDividerBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/layoutBottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="8dp">

        <!-- Nút Edit -->
        <LinearLayout
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Nút New -->
        <LinearLayout
            android:id="@+id/btnNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mới"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Nút Share -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chia sẻ"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Nút Export -->
        <LinearLayout
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_export"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xuất"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── SECTION "Export As" bên dưới toolbar ── -->
    <LinearLayout
        android:id="@+id/layoutExportAs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xuất dạng"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 4 icon format: Word / PDF / Excel / Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Word -->
            <LinearLayout
                android:id="@+id/exportWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/export_word_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_docx"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Word"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".docx"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

            <!-- PDF -->
            <LinearLayout
                android:id="@+id/exportPdf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/export_pdf_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_pdf"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".pdf"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

            <!-- Excel -->
            <LinearLayout
                android:id="@+id/exportExcel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/export_excel_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_excel"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Excel"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".xlsx"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

            <!-- Text -->
            <LinearLayout
                android:id="@+id/exportText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/export_text_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_txt"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".txt"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
