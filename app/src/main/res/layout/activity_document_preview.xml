<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ── TOOLBAR ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/surface">

        <!-- Nút back -->
        <ImageView
            android:id="@+id/imgBackPreview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Tiêu đề toolbar -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Document Preview"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginEnd="40dp" />

    </LinearLayout>

    <!-- ── TAB: Original / Extracted ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@color/surface"
        android:gravity="center_vertical">

        <!-- Tab Original -->
        <TextView
            android:id="@+id/tabOriginal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Original"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <!-- Tab Extracted (active mặc định) -->
        <TextView
            android:id="@+id/tabExtracted"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Extracted"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@color/primary"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── BADGE: DOCUMENT EXTRACTED ── -->
    <TextView
        android:id="@+id/txtStatusBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DOCUMENT EXTRACTED"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/status_badge_green"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/surface" />

    <!-- ── NỘI DUNG CHÍNH (cuộn được) ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card nội dung text trích xuất -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExtractedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <TextView
                    android:id="@+id/txtExtractedContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="4dp"
                    android:text="(Chưa có nội dung)"
                    android:textIsSelectable="true" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Ảnh gốc (hiện khi tab Original) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOriginalImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider">

                <ImageView
                    android:id="@+id/imgOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ── KHU VỰC TƯƠNG TÁC AI (GEMINI) ── -->
            <LinearLayout
                android:id="@+id/layoutAiSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp">

                <!-- Tiêu đề mục AI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRỢ LÝ AI"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <!-- Các nút hành động AI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSummarize"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tóm tắt"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTranslate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dịch TV"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        android:layout_marginHorizontal="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExtract"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trích xuất"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <!-- Loading AI -->
                <LinearLayout
                    android:id="@+id/layoutAiLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminateTint="@color/primary" />

                    <TextView
                        android:id="@+id/txtAiLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini đang phân tích tài liệu..."
                        android:textSize="13sp"
                        android:textColor="@color/primary"
                        android:layout_marginStart="10dp" />

                </LinearLayout>

                <!-- Card kết quả AI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Kết quả AI"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyAi"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sao chép"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtAiResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:textIsSelectable="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Card Smart Q&A -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Hỏi đáp về tài liệu"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClearQa"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Xóa chat"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <!-- ListView lịch sử chat -->
                        <ListView
                            android:id="@+id/lvQaHistory"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:scrollbars="vertical"
                            android:divider="@null"
                            android:dividerHeight="0dp"
                            android:nestedScrollingEnabled="true"
                            android:visibility="gone" />

                        <!-- Placeholder khi chưa có tin nhắn -->
                        <TextView
                            android:id="@+id/txtQaPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center"
                            android:text="Đặt câu hỏi về nội dung tài liệu để Gemini trả lời..."
                            android:textColor="@color/text_hint"
                            android:textSize="12sp"
                            android:textAlignment="center" />

                        <!-- ── GỢI Ý CÂU HỎI NHANH (PROMPT CHIPS) ── -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="2dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipNoiDungChinh"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nội dung chính là gì?"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_primary"
                                    app:chipBackgroundColor="@color/surface"
                                    app:chipStrokeColor="@color/divider"
                                    app:chipStrokeWidth="1dp"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipNgayThang"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Có ngày tháng/hạn chót nào không?"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_primary"
                                    app:chipBackgroundColor="@color/surface"
                                    app:chipStrokeColor="@color/divider"
                                    app:chipStrokeWidth="1dp"
                                    android:layout_marginEnd="6dp" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSoLieu"
                                    style="@style/Widget.MaterialComponents.Chip.Action"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Trích xuất các số liệu quan trọng"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_primary"
                                    app:chipBackgroundColor="@color/surface"
                                    app:chipStrokeColor="@color/divider"
                                    app:chipStrokeWidth="1dp" />

                            </LinearLayout>

                        </HorizontalScrollView>

                        <!-- Khung nhập câu hỏi -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                app:boxCornerRadiusTopStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusBottomEnd="10dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtCauHoi"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Hỏi về tài liệu này..."
                                    android:textSize="13sp"
                                    android:inputType="text"
                                    android:imeOptions="actionSend"
                                    android:textColor="@color/text_primary"
                                    android:textColorHint="@color/text_hint"
                                    android:maxLines="2" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGuiCauHoi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gửi"
                                android:textSize="13sp"
                                app:cornerRadius="10dp"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- ── TOOLBAR HÀNH ĐỘNG: Edit / New / Share / Export ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="8dp">

        <!-- Nút Edit -->
        <LinearLayout
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Nút New -->
        <LinearLayout
            android:id="@+id/btnNew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Nút Share -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Nút Export -->
        <LinearLayout
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_export"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── SECTION "Export As" bên dưới toolbar ── -->
    <LinearLayout
        android:id="@+id/layoutExportAs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export As"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 4 icon format: Word / PDF / Excel / Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Word -->
            <LinearLayout
                android:id="@+id/exportWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/export_word_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_docx"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Word"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".docx"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

            <!-- PDF -->
            <LinearLayout
                android:id="@+id/exportPdf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/export_pdf_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_pdf"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PDF"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".pdf"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

            <!-- Excel -->
            <LinearLayout
                android:id="@+id/exportExcel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/export_excel_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_excel"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Excel"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".xlsx"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

            <!-- Text -->
            <LinearLayout
                android:id="@+id/exportText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/export_text_bg">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_txt"
                        android:padding="8dp" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=".txt"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
