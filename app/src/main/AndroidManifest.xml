<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Quyền truy cập Internet-->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Quyền Camera-->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Quyền đọc ảnh từ thư viện-->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Quyền đọc bộ nhớ-->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Khai báo yêu cầu Camera-->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Khai báo Package Visibility cho Google Play Services trên Android 11+ (API 30+) -->
    <queries>
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
        </intent>
    </queries>

    <application
        android:name=".SmartDocsApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartDocs">

        <!-- Tự động tải model ML Kit OCR qua Google Play Services -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />
        <!-- MainActivity: Màn hình chính chụp ảnh và scan -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- DocumentPreviewActivity: màn hình xem chi tiết tài liệu đã trích xuất -->
        <activity
            android:name=".ui.DocumentPreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />
        <!-- ImagePreviewActivity: man hinh xem anh va crop truoc khi OCR -->
        <activity
            android:name=".ui.ImagePreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />
        <!-- DangNhapActivity: man hinh dang nhap / dang ky thay the dialog -->
        <activity
            android:name=".ui.DangNhapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".ui.MainActivity" />
        <!--
            FileProvider: bắt buộc cho Android 7+ khi truyền URI ảnh Camera
            cho Intent chụp ảnh (ACTION_IMAGE_CAPTURE).
            authorities phải khớp với giá trị dùng trong code Java.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>